# Container topology only; everything else belongs in meerpic.toml.
# Precedence: environment > .env > meerpic.toml > built-in default.

# Where docker compose publishes the UI. Keep the 127.0.0.1 prefix unless you
# have put TLS and a password in front of it: this is every photo you own.
MEERPIC_BIND=127.0.0.1
MEERPIC_PORT=8040

# The folder mounted into both containers, at the same path it has here. It
# has to contain every folder in [library] roots. The agent gets it read-write
# (the Sync button is rclone writing new photos into it), the server read-only.
# Default: ~/Pictures
# MEERPIC_PICTURES=/home/you/Pictures

# Thumbnails, video previews, the search model. Must match [cache] dir.
# Default: ~/.cache/meerpic
# MEERPIC_CACHE=/home/you/.cache/meerpic

# Where your rclone.conf lives, mounted into the agent read-write because
# rclone refreshes the iCloud session in it. Default: ~/.config/rclone
# RCLONE_CONFIG_DIR=/home/you/.config/rclone

# The zone a photo with no offset of its own is read in, for as long as
# meerpic.toml says timezone = "system". `make up` fills it from the host.
TZ=

# The bundled Postgres. Change the password here and in meerpic.toml.
POSTGRES_USER=meerpic
POSTGRES_PASSWORD=meerpic
POSTGRES_DB=meerpic
# 5434: meerail has 5432 and meercal 5433.
MEERPIC_DB_PORT=5434

# The uid/gid the containers run as: yours, so that what they write is yours.
# `make up` passes them; set them if you run `docker compose up` directly.
MEERPIC_UID=1000
MEERPIC_GID=1000
